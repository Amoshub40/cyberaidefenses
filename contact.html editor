<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact | Cyberaidefenses</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <nav>
        <div class="nav-container">
            <div class="logo">CYBERAIDEFENSES.COM</div>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="solutions.html">Solutions</a></li>
                <li><a href="platform.html">Platform</a></li>
                <li><a href="pricing.html">Pricing</a></li>
                <li><a href="contact.html" class="nav-cta">CONTACT</a></li>
            </ul>
        </div>
    </nav>

    <header class="container" style="text-align: center; padding: 100px 40px; background: linear-gradient(180deg, #0a0b10 0%, #111827 100%);">
        <h1 style="font-size: 3rem; margin-bottom: 20px; color: #ffffff;">Secure Communication</h1>
        <p style="color: #9ca3af; font-size: 1.2rem; max-width: 700px; margin: 0 auto;">Connect with our technical team to discuss autonomous defense integration, federal grant partnerships, or enterprise support.</p>
    </header>

    <main class="container" style="padding: 60px 20px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; max-width: 1000px; margin: 0 auto;">
            
            <div style="background: #111827; padding: 40px; border-radius: 12px; border: 1px solid #1f2937;">
                <h2 style="color: #ffffff; margin-bottom: 30px;">Direct Channels</h2>
                
                <div style="margin-bottom: 25px;">
                    <h4 style="color: #38bdf8; margin-bottom: 5px;">Enterprise Support</h4>
                    <p style="color: #ffffff; font-size: 1.1rem;">support@cyberaidefenses.com</p>
                </div>

                <div style="margin-bottom: 25px;">
                    <h4 style="color: #38bdf8; margin-bottom: 5px;">Grant & Partnerships</h4>
                    <p style="color: #ffffff; font-size: 1.1rem;">partners@cyberaidefenses.com</p>
                </div>

                <div>
                    <h4 style="color: #38bdf8; margin-bottom: 5px;">Global Head Office</h4>
                    <p style="color: #ffffff; font-size: 1.1rem;">+1 (555) 012-3456</p>
                    <p style="color: #9ca3af; font-size: 0.9rem; margin-top: 5px;">Available Mon-Fri, 9am - 6pm EST</p>
                </div>
            </div>

            <form style="background: #111827; padding: 40px; border-radius: 12px; border: 1px solid #1f2937;">
                <h2 style="color: #ffffff; margin-bottom: 30px;">Send a Message</h2>
                <div style="margin-bottom: 20px;">
                    <label style="color: #ffffff; display: block; margin-bottom: 8px;">Full Name</label>
                    <input type="text" placeholder="John Doe" style="width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: white;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="color: #ffffff; display: block; margin-bottom: 8px;">Professional Email</label>
                    <input type="email" placeholder="name@company.com" style="width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: white;">
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="color: #ffffff; display: block; margin-bottom: 8px;">Message</label>
                    <textarea rows="4" placeholder="How can we assist with your infrastructure?" style="width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: white;"></textarea>
                </div>
                <button type="button" style="width: 100%; padding: 15px; background: #0055ff; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s;">Submit Inquiry</button>
            </form>
        </div>
    </main>

    <footer style="padding: 60px 0; text-align: center; border-top: 1px solid #1f2937; margin-top: 60px;">
        <p style="color: #4b5563;">&copy; 2026 Cyberaidefenses LLC. All Rights Reserved.</p>
    </footer>
</body>
</html>
